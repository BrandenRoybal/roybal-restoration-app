{
  "name": "roybal-restoration-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/field",
    "apps/board",
    "apps/site"
  ],
  "scripts": {
    "test": "npm run field:test && npm run board:test && npm run fn:test",
    "fn:test": "for f in supabase/functions/*/*.test.mjs; do echo \"— $f\"; node --experimental-strip-types --no-warnings \"$f\" || exit 1; done",
    "field": "npm run dev --workspace=apps/field",
    "field:test": "npm run test --workspace=apps/field",
    "board": "npm run dev --workspace=apps/board",
    "board:test": "npm run test --workspace=apps/board",
    "site": "npm run dev --workspace=apps/site",
    "site:build": "npm run build --workspace=apps/site",
    "site:check-live": "npm run check-live --workspace=apps/site --",
    "setup": "npm install"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

# Copy to .env for local dev. Astro exposes only PUBLIC_*-prefixed vars to the
# browser, which is what we want here — this endpoint is meant to be called
# from the public site and holds no secret.

# Where the quote form posts. Leaving it blank makes the form a no-op, so set
# it before cutover.
PUBLIC_LEAD_ENDPOINT=https://djpgvcvhvgrzgaziruze.supabase.co/functions/v1/roybal-lead

# The AI receptionist panel. Unset or blank = the panel is not rendered at all.
PUBLIC_WEB_AGENT_ENDPOINT=https://djpgvcvhvgrzgaziruze.supabase.co/functions/v1/roybal-web-agent

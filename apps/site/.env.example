# OPTIONAL since 2026-08-14 — the production values below are committed as
# defaults in src/data/site.ts, so a build with no .env at all ships a working
# quote form and receptionist. (Before that, a fresh clone/worktree silently
# built without both. Never again.)
#
# Copy to .env only when you need to OVERRIDE. Astro exposes only
# PUBLIC_*-prefixed vars to the browser, which is what we want here — these
# endpoints are meant to be called from the public site and hold no secret.

# Where the quote form posts. Unset = the committed production default.
# There is no "form off" state: setting this to "" or "off" makes the
# postbuild guard fail the build rather than deploy a dead form.
PUBLIC_LEAD_ENDPOINT=https://djpgvcvhvgrzgaziruze.supabase.co/functions/v1/roybal-lead

# The AI receptionist panel. Unset = the committed production default.
# EXPLICITLY setting "" or "off" is the build-time kill switch: the panel is
# not rendered at all (the postbuild guard warns and lets that build pass).
# The no-rebuild kill switch is: supabase secrets set WEB_AGENT_ENABLED=false
PUBLIC_WEB_AGENT_ENDPOINT=https://djpgvcvhvgrzgaziruze.supabase.co/functions/v1/roybal-web-agent

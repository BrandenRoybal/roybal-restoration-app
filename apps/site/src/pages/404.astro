---
/* Served by Cloudflare for any unknown path (`not_found_handling: "404-page"`
   in wrangler.jsonc), with a real 404 status.

   noindex, and deliberately NOT in the sitemap — Astro excludes it
   automatically because the sitemap integration skips 404.

   The job of this page is to not lose the visitor: someone who mistyped a URL
   or followed a stale link is still a lead, so it offers the services, the
   phone number, and the estimate form rather than a dead end. */
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { BUSINESS, RESTORATION_SERVICES, CONSTRUCTION_SERVICES } from "../data/site";
---

<Base
  title="Page not found"
  description="That page doesn't exist. Find Roybal Construction's restoration and construction services in Fairbanks, Alaska."
  noindex={true}
>
  <section class="nf">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page</h1>
      <p class="lede">
        The link may be out of date, or the address may have a typo. Here's everything
        we do — or call and we'll point you the right way.
      </p>
      <div class="nf__cta">
        <a class="btn btn--primary" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
        <a class="btn btn--ghost" href="/">Back to the homepage</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Restoration</h2>
      <ul class="nf__list">
        {RESTORATION_SERVICES.map((s) => <li><a href={s.path}>{s.name}</a></li>)}
        <li><a href="/restoration-services">All restoration services</a></li>
      </ul>

      <h2 style="margin-top:2.5rem">Construction</h2>
      <ul class="nf__list">
        {CONSTRUCTION_SERVICES.map((s) => <li><a href={s.path}>{s.name}</a></li>)}
      </ul>

      <h2 style="margin-top:2.5rem">Everything else</h2>
      <ul class="nf__list">
        <li><a href="/about-roybal-construction-llc">About us</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/read-reviews">Reviews</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact-us">Contact</a></li>
      </ul>
    </div>
  </section>

  <CtaBand heading="Still can't find it?" />
</Base>

<style>
  .nf {
    background: var(--navy-900);
    color: var(--slate-300);
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .nf h1 { color: var(--white); }
  .nf .lede { color: var(--slate-300); margin-top: 0.8rem; }
  .nf__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .nf__list {
    columns: 2;
    column-gap: 2rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  @media (max-width: 620px) { .nf__list { columns: 1; } }
  .nf__list li { margin-bottom: 0.5rem; break-inside: avoid; }
  .nf__list a { color: var(--orange-dark); text-decoration: none; }
  .nf__list a:hover { text-decoration: underline; }
</style>

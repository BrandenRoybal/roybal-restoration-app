---
/* Closing call to action. Every service, location, and blog page ends with
   this, so there is always a conversion path at the bottom of the scroll. */
import { BUSINESS } from "../data/site";

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Ready to get started?",
  body = "Tell us about your project and we'll get you a free estimate. Emergency? Call — we answer 24/7.",
} = Astro.props;
---

<section class="cta">
  <div class="wrap cta__inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta__btns">
      <a class="btn btn--primary" href="/contact-us">Get a Free Estimate</a>
      <a class="btn btn--ghost" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--navy-800);
    color: var(--slate-300);
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta h2 { color: var(--white); font-size: var(--step-2); margin-bottom: 0.4rem; }
  .cta p { margin: 0; max-width: 52ch; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
